rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user is the admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == "mohammadborshonhossain6@gmail.com";
    }

    // User profiles: Only the user can read/write their own profile. Admin can read all.
    match /users/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Admin-only global stats (like member count)
    match /stats/{statId} {
      allow read: if isAdmin();
      allow write: if false; // Only manageable via backend or manual intervention
    }
  }
}
